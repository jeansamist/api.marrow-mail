# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=marrow_mail
DB_SSL=false


# SMTP Mailer
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=

# Mailer
MAIL_MAILER=smtp
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com

# AWS
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

FRONTEND_APP_URL=http://localhost:3000
#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Stripe (card subscription payments)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRODUCT_CORE_ID=prod_your-core-product-id
STRIPE_PRODUCT_PLUS_ID=prod_your-plus-product-id
STRIPE_CURRENCY=xaf

# Elgiopay (mobile money payments)
ELGIOPAY_API_BASE_URL=https://sandbox-api.elgiopay.com
ELGIOPAY_SECRET_KEY=pk_test_your-secret-key
ELGIOPAY_WEBHOOK_SECRET=whsec_your-webhook-secret