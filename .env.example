# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Signs mail-account access tokens — required, generate with `openssl rand -hex 32`
JWT_SECRET=

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=marrow_mail
DB_SSL=false


# SMTP Mailer
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=

# Mailer
MAIL_MAILER=smtp
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com

# AWS
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET=your-s3-bucket-name
AWS_SES_RULE_SET_NAME=your-ses-receipt-rule-set-name

FRONTEND_APP_URL=http://localhost:3000
#--------------------------------------------------------------------
# CORS — comma-separated origin allowlist, enforced in production.
# Ignored in development, where every origin is allowed.
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Stripe (card subscription payments)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRODUCT_CORE_ID=prod_your-core-product-id
STRIPE_PRODUCT_PLUS_ID=prod_your-plus-product-id
STRIPE_CURRENCY=xaf

# Elgiopay (mobile money payments)
ELGIOPAY_API_BASE_URL=https://sandbox-api.elgiopay.com
ELGIOPAY_SECRET_KEY=pk_test_your-secret-key
ELGIOPAY_WEBHOOK_SECRET=whsec_your-webhook-secret

# Custom login hostname (e.g. mail.<customer-domain>) — A record target IP.
# Use the value shown on this Vercel project's domain card (Settings > Domains),
# not necessarily 76.76.21.21 — Vercel assigns project-specific anycast IPs.
CUSTOM_LOGIN_HOSTNAME_TARGET_IP=76.76.21.21