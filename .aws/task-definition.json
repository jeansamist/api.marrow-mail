{
  "family": "marrow-mail-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/marrow-mail-api-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/marrow-mail-api-task-role",
  "containerDefinitions": [
    {
      "name": "api-marrowmail",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/api-marrowmail:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "stopTimeout": 30,
      "environment": [
        { "name": "TZ", "value": "UTC" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "80" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "APP_NAME", "value": "marrow-mail-api" },
        {
          "name": "APP_URL",
          "value": "https://api.marrowmails.com"
        },
        { "name": "SESSION_DRIVER", "value": "cookie" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_DATABASE", "value": "neondb" },
        { "name": "DB_SSL", "value": "true" },
        { "name": "SMTP_PORT", "value": "465" },
        { "name": "SMTP_SECURE", "value": "true" },
        { "name": "MAIL_MAILER", "value": "smtp" },
        { "name": "MAIL_FROM_NAME", "value": "Marrowmail" },
        { "name": "MAIL_FROM_ADDRESS", "value": "no-reply@marrowmails.com" },
        { "name": "FRONTEND_APP_URL", "value": "https://marrowmails.com" },
        { "name": "CORS_ORIGIN", "value": "https://marrowmails.com" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_BUCKET", "value": "marrow-mail-s3" },
        { "name": "AWS_SES_RULE_SET_NAME", "value": "marrow-mail" },
        { "name": "STRIPE_CURRENCY", "value": "xaf" },
        { "name": "ELGIOPAY_API_BASE_URL", "value": "https://api.elgiopay.com" }
      ],
      "secrets": [
        {
          "name": "APP_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:APP_KEY::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:JWT_SECRET::"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:DB_HOST::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:DB_USER::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:DB_PASSWORD::"
        },
        {
          "name": "SMTP_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:SMTP_HOST::"
        },
        {
          "name": "SMTP_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:SMTP_USERNAME::"
        },
        {
          "name": "SMTP_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:SMTP_PASSWORD::"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:AWS_ACCESS_KEY_ID::"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:AWS_SECRET_ACCESS_KEY::"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:STRIPE_SECRET_KEY::"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:STRIPE_WEBHOOK_SECRET::"
        },
        {
          "name": "STRIPE_PRODUCT_CORE_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:STRIPE_PRODUCT_CORE_ID::"
        },
        {
          "name": "STRIPE_PRODUCT_PLUS_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:STRIPE_PRODUCT_PLUS_ID::"
        },
        {
          "name": "ELGIOPAY_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:ELGIOPAY_SECRET_KEY::"
        },
        {
          "name": "ELGIOPAY_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:marrow-mail-0K6qZW:ELGIOPAY_WEBHOOK_SECRET::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/marrow-mail-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
