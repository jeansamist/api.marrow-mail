{
  "family": "marrow-mail-api<FAMILY_SUFFIX>",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/marrow-mail-api-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/marrow-mail-api-task-role",
  "containerDefinitions": [
    {
      "name": "api-marrowmail",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/api-marrowmail:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "stopTimeout": 30,
      "environment": [
        { "name": "TZ", "value": "UTC" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "80" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "LOG_LEVEL", "value": "<LOG_LEVEL>" },
        { "name": "APP_NAME", "value": "marrow-mail-api<FAMILY_SUFFIX>" },
        { "name": "APP_URL", "value": "<APP_URL>" },
        { "name": "SESSION_DRIVER", "value": "cookie" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_DATABASE", "value": "<DB_DATABASE>" },
        { "name": "DB_SSL", "value": "<DB_SSL>" },
        { "name": "SMTP_PORT", "value": "<SMTP_PORT>" },
        { "name": "SMTP_SECURE", "value": "<SMTP_SECURE>" },
        { "name": "MAIL_MAILER", "value": "resend" },
        { "name": "MAIL_FROM_NAME", "value": "<MAIL_FROM_NAME>" },
        { "name": "MAIL_FROM_ADDRESS", "value": "<MAIL_FROM_ADDRESS>" },
        { "name": "FRONTEND_APP_URL", "value": "<FRONTEND_APP_URL>" },
        { "name": "CORS_ORIGIN", "value": "<CORS_ORIGIN>" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_BUCKET", "value": "<AWS_BUCKET>" },
        { "name": "AWS_SES_RULE_SET_NAME", "value": "<AWS_SES_RULE_SET_NAME>" },
        { "name": "CUSTOM_LOGIN_HOSTNAME_TARGET_IP", "value": "<CUSTOM_LOGIN_HOSTNAME_TARGET_IP>" },
        { "name": "STRIPE_CURRENCY", "value": "xaf" },
        { "name": "ELGIOPAY_API_BASE_URL", "value": "<ELGIOPAY_API_BASE_URL>" }
      ],
      "secrets": [
        { "name": "APP_KEY", "valueFrom": "<SECRET_ARN>:APP_KEY::" },
        { "name": "JWT_SECRET", "valueFrom": "<SECRET_ARN>:JWT_SECRET::" },
        { "name": "DB_HOST", "valueFrom": "<SECRET_ARN>:DB_HOST::" },
        { "name": "DB_USER", "valueFrom": "<SECRET_ARN>:DB_USER::" },
        { "name": "DB_PASSWORD", "valueFrom": "<SECRET_ARN>:DB_PASSWORD::" },
        { "name": "SMTP_HOST", "valueFrom": "<SECRET_ARN>:SMTP_HOST::" },
        { "name": "SMTP_USERNAME", "valueFrom": "<SECRET_ARN>:SMTP_USERNAME::" },
        { "name": "SMTP_PASSWORD", "valueFrom": "<SECRET_ARN>:SMTP_PASSWORD::" },
        { "name": "RESEND_API_KEY", "valueFrom": "<SECRET_ARN>:RESEND_API_KEY::" },
        { "name": "AWS_ACCESS_KEY_ID", "valueFrom": "<SECRET_ARN>:AWS_ACCESS_KEY_ID::" },
        { "name": "AWS_SECRET_ACCESS_KEY", "valueFrom": "<SECRET_ARN>:AWS_SECRET_ACCESS_KEY::" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "<SECRET_ARN>:STRIPE_SECRET_KEY::" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "<SECRET_ARN>:STRIPE_WEBHOOK_SECRET::" },
        { "name": "STRIPE_PRODUCT_CORE_ID", "valueFrom": "<SECRET_ARN>:STRIPE_PRODUCT_CORE_ID::" },
        { "name": "STRIPE_PRODUCT_PLUS_ID", "valueFrom": "<SECRET_ARN>:STRIPE_PRODUCT_PLUS_ID::" },
        { "name": "ELGIOPAY_SECRET_KEY", "valueFrom": "<SECRET_ARN>:ELGIOPAY_SECRET_KEY::" },
        { "name": "ELGIOPAY_WEBHOOK_SECRET", "valueFrom": "<SECRET_ARN>:ELGIOPAY_WEBHOOK_SECRET::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "<LOG_GROUP>",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
